<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Redirect</title>
</head>

<body>
    <div>
        <h1>Google Redirecting....</h1>
    </div>
</body>
<script>
    (async () => {
        try {
            const response = await fetch("<%= betterAuthUrl %>/api/auth/sign-in/social", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                credentials: "include",
                body: JSON.stringify({
                    provider: "google",
                    callbackURL: "<%= callbackURL %>"
                })
            })
            const data = await response.json();

            if (data.url) {
                window.location.href = data.url;
            }
            else {
                document.body.innerHTML = `<div>
                    <p>Google Redirect Failed: No URL returned</p>
                </div>`
            }
        } catch (error) {
            document.body.innerHTML = `<div>
                    <p>Google Redirect Failed: ${error.message}</p>
                </div>`
        }
    })()
</script>

</html>